# Client-side QuakeC (csprogs.dat).
#
# The server hands this to connecting clients that support CSQC; mvdsv serves
# whatever sv_csqc_progname points at in the gamedir, defaulting to csprogs.dat.
#
# Needs fteqcc from FTE on PATH: https://www.fteqw.org/

FTEQCC ?= fteqcc
OUT    := ../build/csprogs.dat

.PHONY: all dev release clean

# Default to the debugging build: it keeps the .lno line table, which is what
# lets a debugger map progs addresses back to these sources. Any -O level
# discards it.
all: dev

dev:
	@mkdir -p ../build
	$(FTEQCC) -srcfile progs.src -Tdebug -Wall

release:
	@mkdir -p ../build
	$(FTEQCC) -srcfile progs.src -O2 -Wall

clean:
	rm -f $(OUT) ../build/csprogs.lno

# fteextensions.qc is generated by the engine, not written by hand. To refresh
# it against a newer FTE, run a headless client:
#
#   fteqw -nohome +set vid_renderer sv -nosound \
#         +pr_dumpplatform -Tcs -o fteextensions +quit
#
# and copy the result here.
